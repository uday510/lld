@startuml
actor Driver

participant EntryGate
participant ParkingLot
participant ParkingSpot
participant Ticket
participant ExitGate
participant FareCalculator
participant PaymentProcessor

Driver -> EntryGate : arrive(vehicle)

EntryGate -> ParkingLot : park(vehicle)

ParkingLot -> ParkingLot : allocateSpot(vehicle)

ParkingLot -> ParkingSpot : occupy(vehicle)

ParkingLot -> Ticket : create(vehicle, spot)

ParkingLot --> EntryGate : ticket

EntryGate --> Driver : ticket issued


== Vehicle Leaves ==

Driver -> ExitGate : exit(ticket)

ExitGate -> ParkingLot : unpark(ticket)

ParkingLot -> Ticket : closeTicket()

ParkingLot -> ParkingSpot : vacate()

ParkingLot -> FareCalculator : calculateFare(ticket)

FareCalculator --> ParkingLot : fare

ParkingLot --> ExitGate : fare

ExitGate -> PaymentProcessor : process(fare)

PaymentProcessor --> ExitGate : paymentSuccess

ExitGate --> Driver : exit complete

@enduml